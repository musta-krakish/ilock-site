---
import Partners from '../../components/Partners.astro';
import Layout from '../../layouts/Layout.astro';
import { langList, type Lang, ui } from '../../i18n';

export function getStaticPaths() {
	return langList.filter((lang) => lang !== 'ru').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const copy = ui[lang].partners;
---

<Layout lang={lang} title={copy.pageTitle} description={copy.pageDescription}>
	<Partners lang={lang} standalone />
</Layout>
