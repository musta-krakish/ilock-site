---
import AboutUs from '../../components/AboutUs.astro';
import Layout from '../../layouts/Layout.astro';
import { defaultLang, langList, type Lang, ui } from '../../i18n';

export function getStaticPaths() {
	return langList.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const copy = ui[lang].company;
---

<Layout lang={lang} title={copy.pageTitle} description={copy.pageDescription}>
	<AboutUs lang={lang} standalone />
</Layout>
