---
import { formatPrice } from '../../config';
import {
	getGitHubYaml,
	isPreviewBranch,
	isPreviewSlug,
	resolveRepositoryPath,
} from '../../lib/github-preview';
import Layout from '../../layouts/Layout.astro';
import { brandNames, type Brand, ui } from '../../i18n';

export const prerender = false;

type PreviewLock = {
	title?: unknown;
	brand?: unknown;
	kind?: unknown;
	price?: unknown;
	priceTo?: unknown;
	image?: unknown;
	comingSoon?: unknown;
	featured?: unknown;
	access?: unknown;
	features?: unknown;
	ru?: { description?: unknown; body?: unknown };
};

const branch = Astro.url.searchParams.get('branch');
const slug = Astro.url.searchParams.get('slug');
let lock: PreviewLock | null = null;
let error = '';

if (!isPreviewBranch(branch) || !isPreviewSlug(slug)) {
	error = 'Не удалось определить ветку или модель для предпросмотра.';
} else {
	try {
		const content = await getGitHubYaml(`src/content/locks/${slug}.yaml`, branch);
		if (!content || typeof content !== 'object' || Array.isArray(content)) {
			throw new Error('Invalid product data');
		}
		lock = content as PreviewLock;
	} catch {
		error = 'Эта версия товара ещё не найдена в GitHub. Сначала сохраните изменения в Keystatic.';
	}
}

const text = (value: unknown, fallback = '') => (typeof value === 'string' ? value : fallback);
const number = (value: unknown) => (typeof value === 'number' && Number.isFinite(value) ? value : 0);
const title = text(lock?.title, 'Товар');
const brand = text(lock?.brand);
const brandLabel = brand in brandNames ? brandNames[brand as Brand] : brand || 'iLOCK';
const kind = lock?.kind === 'safe' ? 'Сейф' : 'Умный замок';
const description = text(lock?.ru?.description, 'Описание появится после заполнения поля «Русский».');
const body = text(lock?.ru?.body);
const price = number(lock?.price);
const priceTo = typeof lock?.priceTo === 'number' ? lock.priceTo : undefined;
const imagePath = typeof lock?.image === 'string'
	? resolveRepositoryPath(`src/content/locks/${slug ?? 'entry'}.yaml`, lock.image)
	: null;
const imageUrl = branch && imagePath
	? `/preview/image?branch=${encodeURIComponent(branch)}&path=${encodeURIComponent(lock?.image as string)}`
	: null;
const access = Array.isArray(lock?.access) ? lock.access.filter((item): item is string => typeof item === 'string') : [];
const features = Array.isArray(lock?.features) ? lock.features.filter((item): item is string => typeof item === 'string') : [];
const russianSpecs = ui.ru.specs as unknown as {
	access: Record<string, string>;
	feature: Record<string, string>;
};
const accessLabels = access.map((item) => russianSpecs.access[item] ?? item);
const featureLabels = features.map((item) => russianSpecs.feature[item] ?? item);
---

<Layout lang="ru" title={`Предпросмотр · ${title}`} description={description} image={imageUrl ?? undefined} noindex>
	<section class="min-h-screen bg-main-color px-5 pb-16 pt-28 text-white sm:px-8 sm:pt-32 lg:px-12">
		<div class="mx-auto max-w-7xl">
			<div class="mb-8 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-accent-color/30 bg-accent-color/10 px-5 py-3 text-sm text-white/80">
				<p><strong class="font-semibold text-accent-color">Предпросмотр</strong> · изменения из ветки {branch ?? '—'}</p>
				<p class="text-white/50">Сохраните товар в Keystatic и обновите эту вкладку.</p>
			</div>

			{
				error ? (
					<div class="rounded-3xl border border-red-400/30 bg-red-400/10 p-8 text-lg text-white/80">{error}</div>
				) : (
					<div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
						<div class="relative overflow-hidden rounded-3xl border border-line bg-linear-to-b from-[#d2d2d2] to-[#bdbdbd]">
							{
								imageUrl ? (
									<img
										src={imageUrl}
										alt={`${kind} ${brandLabel} ${title}`}
										class="aspect-square w-full object-contain p-8 sm:p-12"
									/>
								) : (
									<div class="flex aspect-square items-center justify-center p-8 text-center text-main-color/60">
										Добавьте фото товара, чтобы увидеть его здесь.
									</div>
								)
							}
							<div class="absolute left-4 top-4 flex flex-col items-start gap-2">
								{
									lock?.featured && !lock?.comingSoon && (
										<span class="rounded-full bg-accent-color px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-main-color">Хит продаж</span>
									)
								}
								{
									lock?.comingSoon && (
										<span class="rounded-full border border-accent-color/60 bg-main-color/85 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-accent-color">Скоро в продаже</span>
									)
								}
							</div>
						</div>

						<div>
							<p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-accent-color">
								<span class="h-px w-8 bg-accent-color"></span>{brandLabel}
							</p>
							<h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">{kind} {brandLabel} {title}</h1>
							<p class="mt-5 text-base leading-7 text-white/60 sm:text-lg sm:leading-8">{description}</p>
							<p class="mt-7 text-3xl font-semibold tracking-tight text-accent-color sm:text-4xl">{price ? formatPrice(price, priceTo) : 'Укажите цену'}</p>

							{
								access.length > 0 && (
									<div class="mt-9">
							<h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-white/45">Способы разблокировки</h2>
							<ul class="mt-4 flex flex-wrap gap-2">
								{accessLabels.map((item) => (
									<li class="rounded-full border border-accent-color/30 bg-accent-color/5 px-3.5 py-1.5 text-sm text-white/80">{item}</li>
								))}
							</ul>
									</div>
								)
							}
							{
								features.length > 0 && (
							<div class="mt-7">
								<h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-white/45">Особенности</h2>
								<p class="mt-3 text-sm leading-6 text-white/70">{featureLabels.join(' · ')}</p>
							</div>
								)
							}
						</div>
						{body && <div class="border-t border-line pt-10 lg:col-span-2"><h2 class="text-2xl font-bold">О модели</h2><p class="mt-5 max-w-4xl whitespace-pre-line text-base leading-8 text-white/60">{body}</p></div>}
					</div>
				)
			}
		</div>
	</section>
</Layout>
