---
import type { YouTubeVideo } from '../lib/youtube';

interface Props {
	video: YouTubeVideo;
	title: string;
	label: string;
}

const { video, title, label } = Astro.props;
---

{/* Click-to-play: YouTube's player (~1 MB of scripts) loads only when asked for. */}
<button
	type="button"
	data-youtube-id={video.id}
	data-youtube-title={title}
	aria-label={`${label}: ${title}`}
	class="group absolute inset-0 h-full w-full"
>
	<img
		src={`https://i.ytimg.com/vi/${video.id}/${video.vertical ? 'oar2' : 'hqdefault'}.jpg`}
		onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${video.id}/hqdefault.jpg'`}
		alt=""
		loading="lazy"
		decoding="async"
		class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
	/>
	<span class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent" aria-hidden="true"></span>
	<span
		class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent-color text-main-color shadow-lg transition group-hover:scale-110"
		aria-hidden="true"
	>
		<svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 fill-current">
			<path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.24-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14z"></path>
		</svg>
	</span>
</button>

<script>
	const pause = (iframe: HTMLIFrameElement) =>
		iframe.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }), '*');

	// A video swiped or scrolled out of view stops instead of playing on unseen.
	const offscreen = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) pause(entry.target as HTMLIFrameElement);
			}
		},
		{ threshold: 0.4 },
	);

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-youtube-id]')) {
		button.addEventListener('click', () => {
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.youtubeId}?autoplay=1&rel=0&playsinline=1&enablejsapi=1`;
			iframe.title = button.dataset.youtubeTitle ?? 'YouTube';
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.className = 'absolute inset-0 h-full w-full';
			button.replaceWith(iframe);
			offscreen.observe(iframe);
		});
	}
</script>
