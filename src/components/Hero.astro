---
import { Image } from 'astro:assets';
import heroLock from '../assets/zamok.png';
import { site } from '../config';
import { getLocalePath, type Lang, ui } from '../i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
const homePath = getLocalePath(lang);

const stats = [
	{ value: String(site.stats.choiceYear), label: t.hero.choice, highlight: true },
	{ value: String(site.stats.years), label: t.hero.years },
	{ value: String(site.stats.branches), label: t.hero.branches },
	{ value: String(site.stats.warranty), label: t.hero.warranty },
];
---

<section class="relative isolate overflow-hidden bg-main-color text-white lg:px-12">
	<div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[52%] lg:block">
		<Image
			src={heroLock}
			alt="Умный замок iLock на двери"
			widths={[720, 960, 1122]}
			sizes="52vw"
			class="h-full w-full object-cover object-left-top"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-linear-to-r from-main-color via-main-color/40 to-transparent"></div>
	</div>

	<div class="pointer-events-none absolute inset-x-0 top-0 h-[78svh] lg:hidden" aria-hidden="true">
		<Image
			src={heroLock}
			alt=""
			widths={[480, 720, 960]}
			sizes="100vw"
			class="h-full w-full scale-105 object-cover object-[78%_top]"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-linear-to-b from-main-color/15 via-main-color/10 to-main-color"></div>
		<div class="absolute inset-0 bg-linear-to-t from-main-color via-main-color/40 to-transparent"></div>
		<div class="absolute inset-x-0 top-0 h-36 bg-linear-to-b from-main-color/95 to-transparent"></div>
		<div class="absolute inset-x-0 bottom-0 h-52 bg-linear-to-t from-main-color via-main-color/95 to-transparent"></div>
	</div>

	<div
		class="pointer-events-none absolute inset-x-0 top-[calc(100svh-14rem)] h-64 bg-main-color lg:hidden"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-0">
		<div
			class="grid min-h-[calc(100svh-2rem)] items-end gap-0 pb-8 pt-32 sm:pb-14 lg:min-h-152 lg:grid-cols-2 lg:items-center lg:gap-8 lg:pt-40 lg:pb-28"
		>
			<div class="relative lg:mt-0">
				<div
					class="mobile-glass mb-6 inline-flex items-center gap-2 rounded-full border px-3.5 py-2 lg:hidden"
				>
					<span class="gold-text text-base font-semibold tracking-tight">{site.stats.choiceYear}</span>
					<span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-white/68">
						{t.hero.choice}
					</span>
				</div>
				<p
					class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-accent-color sm:text-sm"
				>
					<span class="h-px w-8 shrink-0 bg-accent-color sm:w-12"></span>
					{t.hero.eyebrow}
				</p>

				<h1
					class="mt-5 max-w-[9ch] text-5xl font-semibold leading-[0.98] tracking-tight sm:max-w-none sm:text-6xl lg:mt-7"
				>
					{t.hero.title}
					<span class="mt-1 block text-white/78">{t.hero.tagline}</span>
				</h1>

				<p class="mt-5 max-w-[31ch] text-[15px] leading-7 text-white/70 sm:max-w-md sm:text-lg sm:leading-8 lg:text-white/55">
					{t.hero.text}
				</p>

				<div class="mt-7 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:items-center sm:gap-4 lg:mt-9">
					<a
						href={`${homePath}catalog/`}
						class="group inline-flex h-13 items-center justify-center gap-2 rounded-full bg-accent-color px-5 text-[15px] font-semibold text-main-color shadow-[0_18px_38px_-22px_rgba(223,166,32,0.95)] transition hover:bg-accent-soft sm:flex-none sm:px-8 sm:justify-start lg:h-12"
					>
						{t.hero.catalog}
						<svg
							class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.25"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14M13 6l6 6-6 6"></path>
						</svg>
					</a>
					<a
						href="#lead"
						class="mobile-glass inline-flex h-13 items-center justify-center rounded-full border px-5 text-[15px] font-semibold text-white/88 transition hover:border-accent-color/50 hover:text-accent-color sm:flex-none sm:border-transparent sm:px-6 lg:h-12 lg:bg-transparent lg:shadow-none lg:backdrop-blur-0"
					>
						{t.hero.contact}
					</a>
				</div>

				<div class="mt-6 grid grid-cols-3 gap-2 lg:hidden">
					{stats.slice(1).map((stat) => (
						<div class="mobile-glass rounded-2xl border px-3 py-3">
							<span class="gold-text block text-xl font-semibold tracking-tight">{stat.value}</span>
							<span class="mt-1 block text-[10px] leading-4 text-white/50">{stat.label}</span>
						</div>
					))}
				</div>
			</div>
		</div>

		<dl class="hidden grid-cols-2 gap-x-8 gap-y-8 border-t border-line py-10 sm:grid-cols-4 lg:grid lg:py-12">
			{
				stats.map((stat) => (
					<div>
						<dt class="sr-only">{stat.label}</dt>
						<dd>
							<span
								class:list={[
									'text-3xl font-semibold tracking-tight sm:text-4xl',
									'gold-text',
								]}
							>
								{stat.value}
							</span>
							<span class="mt-2 block text-xs leading-5 text-white/45 sm:text-sm">{stat.label}</span>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
