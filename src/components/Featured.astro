---
import { getCollection } from 'astro:content';
import LockCard from './LockCard.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../config';
import { getLocalePath, localizeLock, sortLocks, type Lang, ui } from '../i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
const homePath = getLocalePath(lang);

const all = sortLocks((await getCollection('locks')).map((lock) => localizeLock(lock, lang)));

const picks = all.filter((lock) => lock.featured).slice(0, 6);
const mobileAllText: Record<Lang, string> = {
	ru: `Все ${all.length} моделей`,
	kk: `Барлығы ${all.length} модель`,
	en: `All ${all.length} models`,
};
---

<section id="popular" class="bg-main-color py-10 sm:px-8 sm:py-14 lg:px-12">
	<div class="mx-auto max-w-7xl">
		<div class="flex flex-wrap items-end justify-between gap-6 px-5 sm:px-0">
			<div class="reveal max-w-2xl">
				<SectionHeading
					eyebrow={t.featured.eyebrow}
					title={t.featured.title}
					accent={t.featured.titleAccent}
					text={t.featured.text}
				/>

				<nav class="mt-5 flex flex-wrap gap-2" aria-label={t.catalog.categories}>
					<a
						href={`${homePath}catalog/?kind=lock`}
						class="rounded-full border border-line px-4 py-2 text-sm font-medium text-white/70 transition hover:border-accent-color/60 hover:bg-accent-color/10 hover:text-accent-color"
					>
						{t.featured.categories.locks}
					</a>
					<a
						href={`${homePath}catalog/?kind=safe`}
						class="rounded-full border border-line px-4 py-2 text-sm font-medium text-white/70 transition hover:border-accent-color/60 hover:bg-accent-color/10 hover:text-accent-color"
					>
						{t.featured.categories.safes}
					</a>
					<a
						href={`${homePath}catalog/?kind=accessory`}
						class="rounded-full border border-line px-4 py-2 text-sm font-medium text-white/70 transition hover:border-accent-color/60 hover:bg-accent-color/10 hover:text-accent-color"
					>
						{t.featured.categories.accessories}
					</a>
					<a
						href={site.kaspiUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full border border-[#F14635]/65 bg-[#F14635]/10 px-4 py-2 text-sm font-semibold text-[#ff776b] transition hover:bg-[#F14635] hover:text-white"
					>
						{t.featured.categories.kaspi}
					</a>
				</nav>
			</div>

			<a
				href={`${homePath}catalog/`}
				class="reveal hidden h-13 shrink-0 items-center rounded-full border border-accent-color/60 px-7 py-3 text-sm font-semibold text-white transition hover:border-accent-color hover:bg-accent-color/10 lg:inline-flex"
			>
				{t.featured.all(all.length)}
			</a>
		</div>

		<div
			class="mobile-snap mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-3 sm:mt-12 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3"
		>
			{picks.map((lock, i) => <LockCard lock={lock} lang={lang} eager={i < 3} />)}
		</div>

		<a
			href={`${homePath}catalog/`}
			class="mx-5 mt-6 inline-flex h-13 w-[calc(100%-2.5rem)] items-center justify-center rounded-full bg-accent-color px-6 text-[15px] font-semibold text-main-color transition hover:bg-accent-soft sm:mx-0 sm:h-14 sm:w-full sm:text-base lg:hidden"
		>
			<span class="sm:hidden">{mobileAllText[lang]}</span>
			<span class="hidden sm:inline">{t.featured.all(all.length)}</span>
		</a>
	</div>
</section>
