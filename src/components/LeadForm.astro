---
import { whatsappLink } from '../config';
import { type Lang, ui } from '../i18n';
import { leadCities, otherCity } from '../lib/lead-cities';

interface Props {
	lang?: Lang;
	preselect?: string;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];

const fieldClass =
	'h-14 w-full rounded-full border border-line bg-surface px-6 text-white placeholder:text-white/30 focus:border-accent-color focus:outline-none';
---

<section id="lead" class="bg-main-color px-5 py-10 sm:px-8 sm:py-14 lg:px-12">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">{t.lead.title}</h2>
		<p class="mt-4 text-base leading-7 text-white/55 sm:text-lg">{t.lead.text}</p>

		<form
			data-lead-form
			data-submit={t.lead.submit}
			data-sending={t.lead.sending}
			novalidate
			class="mt-9 text-left"
		>
			{/* Honeypot: hidden from people, filled in by bots; the server drops such requests. */}
			<div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
				<label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
			</div>

			<div class="grid gap-4 sm:grid-cols-3">
				<div>
					<label for="lead-name" class="sr-only">{t.lead.name}</label>
					<input
						id="lead-name"
						name="name"
						type="text"
						autocomplete="name"
						maxlength="80"
						placeholder={t.lead.name}
						required
						class={fieldClass}
					/>
					<p data-error-for="name" hidden class="mt-1.5 pl-6 text-xs text-red-400">{t.lead.errName}</p>
				</div>

				<div>
					<label for="lead-phone" class="sr-only">{t.lead.phone}</label>
					<input
						id="lead-phone"
						name="phone"
						type="tel"
						inputmode="tel"
						autocomplete="tel"
						maxlength="40"
						placeholder="+7 (___) ___-__-__"
						required
						class={fieldClass}
					/>
					<p data-error-for="phone" hidden class="mt-1.5 pl-6 text-xs text-red-400">{t.lead.errPhone}</p>
				</div>

				<div class="relative">
					<label for="lead-city" class="sr-only">{t.lead.city}</label>
					<select
						id="lead-city"
						name="city"
						required
						class={`${fieldClass} appearance-none pr-12 invalid:text-white/30 [&_option]:bg-secondary-color [&_option]:text-white`}
					>
						<option value="" disabled selected>{t.lead.city}</option>
						{leadCities.map((city) => <option value={city.id}>{city[lang]}</option>)}
						<option value={otherCity}>{t.lead.cityOther}</option>
					</select>
					<svg
						viewBox="0 0 24 24"
						class="pointer-events-none absolute right-5 top-[1.15rem] h-5 w-5 text-white/40"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
					<p data-error-for="city" hidden class="mt-1.5 pl-6 text-xs text-red-400">{t.lead.errCity}</p>
				</div>
			</div>

			<button
				type="submit"
				class="mt-4 inline-flex h-14 w-full items-center justify-center rounded-full bg-accent-color px-8 text-base font-semibold text-main-color transition hover:bg-accent-soft disabled:cursor-wait disabled:opacity-60"
			>
				{t.lead.submit}
			</button>

			<p data-lead-error hidden class="mt-4 text-center text-sm leading-6 text-red-400">
				{t.lead.errSend}
				<a
					href={whatsappLink(t.contact.whatsappHello)}
					target="_blank"
					rel="noopener noreferrer"
					class="ml-1 font-semibold text-[#25D366] underline underline-offset-2"
				>
					WhatsApp →
				</a>
			</p>

			<p class="mt-4 text-center text-xs leading-5 text-white/35">{t.lead.note}</p>
		</form>

		<div
			data-lead-success
			hidden
			class="mt-9 rounded-2xl border border-accent-color/35 bg-accent-color/10 px-6 py-8"
			role="status"
		>
			<p class="text-xl font-semibold text-accent-color">{t.lead.successTitle}</p>
			<p class="mt-2 text-base text-white/70">{t.lead.successText}</p>
		</div>
	</div>
</section>

<script>
	const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'] as const;
	const UTM_STORAGE = 'ilock-utm';

	// UTM tags only arrive on the landing URL; keep them for the rest of the visit.
	function readUtm() {
		const params = new URLSearchParams(location.search);
		const fromUrl = Object.fromEntries(
			UTM_KEYS.filter((key) => params.get(key)).map((key) => [key, params.get(key)]),
		);
		try {
			if (Object.keys(fromUrl).length) sessionStorage.setItem(UTM_STORAGE, JSON.stringify(fromUrl));
			return JSON.parse(sessionStorage.getItem(UTM_STORAGE) ?? '{}');
		} catch {
			return fromUrl;
		}
	}

	const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
	const success = document.querySelector<HTMLElement>('[data-lead-success]');
	const sendError = form?.querySelector<HTMLElement>('[data-lead-error]');
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	if (form && button) {
		const showError = (field: string, show: boolean) => {
			const el = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
			if (el) el.hidden = !show;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (button.disabled) return;

			const data = new FormData(form);
			const name = String(data.get('name') ?? '').trim();
			const phone = String(data.get('phone') ?? '').trim();
			const city = String(data.get('city') ?? '');

			const checks = {
				name: name.length > 0,
				phone: phone.replace(/\D/g, '').length >= 10,
				city: city.length > 0,
			};
			for (const [field, ok] of Object.entries(checks)) showError(field, !ok);
			const firstInvalid = Object.entries(checks).find(([, ok]) => !ok)?.[0];
			if (firstInvalid) {
				form.querySelector<HTMLElement>(`[name="${firstInvalid}"]`)?.focus();
				return;
			}

			button.disabled = true;
			button.textContent = form.dataset.sending ?? '';
			if (sendError) sendError.hidden = true;

			try {
				const response = await fetch('/api/lead', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						name,
						phone,
						city,
						website: String(data.get('website') ?? ''),
						page: location.href,
						referrer: document.referrer,
						utm: readUtm(),
					}),
				});
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				form.hidden = true;
				if (success) success.hidden = false;
			} catch {
				if (sendError) sendError.hidden = false;
			} finally {
				button.disabled = false;
				button.textContent = form.dataset.submit ?? '';
			}
		});

		for (const field of ['name', 'phone', 'city']) {
			const el = form.querySelector(`[name="${field}"]`);
			el?.addEventListener(field === 'city' ? 'change' : 'input', () => showError(field, false));
		}

		readUtm();
	}
</script>
