---
import { site, whatsappLink } from '../config';
import { type Lang, ui } from '../i18n';

interface Props {
	lang?: Lang;
	preselect?: string;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
---

<section id="lead" class="bg-main-color px-5 py-10 sm:px-8 sm:py-14 lg:px-12">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">{t.lead.title}</h2>
		<p class="mt-4 text-base leading-7 text-white/55 sm:text-lg">{t.lead.text}</p>

		{/* Placeholder until the lead form is rebuilt on leads-api. */}
		<a
			href={whatsappLink(t.contact.whatsappHello)}
			target="_blank"
			rel="noopener noreferrer"
			class="group mt-9 flex items-center gap-4 rounded-2xl border border-line bg-secondary-color p-5 text-left shadow-[0_22px_70px_-48px_rgba(223,166,32,0.55)] transition hover:border-[#25D366]/60 sm:p-6"
		>
			<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#25D366]">
				<svg viewBox="0 0 24 24" class="h-6 w-6 fill-white" aria-hidden="true">
					<path
						d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"
					></path>
				</svg>
			</span>
			<span class="min-w-0">
				<span class="block font-semibold text-white">{t.contact.whatsapp}</span>
				<span class="block text-sm text-white/45">{site.phones[0].label}</span>
			</span>
			<span class="ml-auto text-white/30 transition group-hover:text-[#25D366]">→</span>
		</a>

		{/* amoCRM form is disabled for now — uncomment to bring it back.
		<div class="amo-form-host mt-9 rounded-2xl border border-line bg-secondary-color p-4 text-left shadow-[0_22px_70px_-48px_rgba(223,166,32,0.55)] sm:p-6">
			<script is:inline>
				!function(a,m,o,c,r,l){a[o+c]=a[o+c]||{setMeta:function(p){this.params=(this.params||[]).concat([p])}},a[o+r]=a[o+r]||function(f){a[o+r].f=(a[o+r].f||[]).concat([f])},a[o+r]({id:"1745222",hash:"d27aff5a09cd541102b5c60513545ca2",locale:"ru"}),a[o+l]=a[o+l]||function(f,k){a[o+l].f=(a[o+l].f||[]).concat([[f,k]])}}(window,0,"amo_forms_","params","load","loaded");
			</script>
			<script
				id="amoforms_script_1745222"
				async
				charset="utf-8"
				src="https://forms.amocrm.ru/forms/assets/js/amoforms.js?1789382054"
				is:inline
			></script>
		</div>
		*/}
	</div>
</section>
