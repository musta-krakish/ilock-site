---
import VideoFacade from './VideoFacade.astro';
import { type Lang, ui } from '../i18n';
import type { YouTubeVideo } from '../lib/youtube';

interface Props {
	videos: YouTubeVideo[];
	title: string;
	lang?: Lang;
}

const { videos, title, lang = 'ru' } = Astro.props;
const t = ui[lang];
---

{
	videos.length > 0 && (
		// Phones get the videos as gallery slides after the photo, so this section is desktop-only.
		<div class="mt-20 hidden lg:block">
			<h2 class="text-2xl font-bold sm:text-3xl">{t.product.videos}</h2>
			<div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
				{videos.map((video) => (
					<div
						class:list={[
							'relative overflow-hidden rounded-2xl border border-line bg-secondary-color',
							video.vertical ? 'aspect-[9/16]' : 'col-span-2 aspect-video',
						]}
					>
						<VideoFacade video={video} title={title} label={t.product.playVideo} />
					</div>
				))}
			</div>
		</div>
	)
}
