---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import LockCard from './LockCard.astro';
import { formatPrice, whatsappLink } from '../config';
import {
	brandNames,
	canonicalPath,
	getLocalePath,
	localizeLock,
	sortLocks,
	type Lang,
	ui,
} from '../i18n';
import { hasGiftInstallation, promotionCopy } from '../lib/promotions';

interface Props {
	lock: CollectionEntry<'locks'>;
	lang?: Lang;
}

const { lock: entry, lang = 'ru' } = Astro.props;
const t = ui[lang];
const lock = localizeLock(entry, lang);
const homePath = getLocalePath(lang);
const S = t.specs;
const isAccessory = lock.kind === 'accessory';
const hasInstallationGift = hasGiftInstallation(lock);
const promo = promotionCopy[lang];

const all = sortLocks((await getCollection('locks')).map((l) => localizeLock(l, lang))).filter(
	(l) => l.slug !== lock.slug,
);
const related = [
	...all.filter((l) => l.kind === lock.kind && l.brand === lock.brand),
	...all.filter((l) => l.kind === lock.kind && l.brand !== lock.brand),
].slice(0, 3);

const monthlyFor = (price: number) => Math.round(price / 12 / 100) * 100;

const productName = t.product.h1(brandNames[lock.brand], lock.title, lock.kind);

// A colour without a `colorPrices` entry costs the base price and shows the base photo.
// The promotional old price belongs to the base price, so it is hidden for dearer colours.
const colorOptions = lock.colors.map((color) => {
	const custom = lock.colorPrices.find((p) => p.color === color);
	const price = custom?.price ?? lock.price;
	return {
		color,
		name: S.color[color],
		price,
		oldPrice: price === lock.price ? lock.oldPrice : null,
		image: custom?.image ?? lock.image,
	};
});
const hasColorPicker = colorOptions.length > 1 && !lock.priceTo;
const selected = hasColorPicker
	? colorOptions.reduce((min, option) => (option.price < min.price ? option : min))
	: { color: null, name: '', price: lock.price, oldPrice: lock.oldPrice, image: lock.image };
const colorImages = hasColorPicker
	? [...new Map(colorOptions.map((o) => [o.image.src, o.image])).values()]
	: [lock.image];
const orderHref = (colorName?: string) =>
	whatsappLink(t.product.orderMsg(colorName ? `${lock.title} (${colorName})` : lock.title, lock.kind));
const kaspiText = (price: number) => `${t.product.kaspiWord} · ${t.product.kaspiTerm(formatPrice(monthlyFor(price)))}`;

const swatch: Record<(typeof lock.colors)[number], string> = {
	black: '#111111',
	'matte-black': '#262626',
	charcoal: '#36454f',
	obsidian: '#1b1b22',
	gold: 'linear-gradient(135deg, #f3d27a, #b8862b)',
	silver: 'linear-gradient(135deg, #f1f1f1, #a7a7a7)',
	copper: '#b87333',
	bronze: '#9c6b3f',
	titanium: '#7d7f7d',
	coffee: '#5b3a29',
	gray: '#8a8a8a',
	white: '#f5f5f5',
};

const accessValue = lock.access
	.map((a) => {
		const limit = lock.limits?.[a];
		return limit ? `${S.access[a]} (${t.product.upTo} ${limit})` : S.access[a];
	})
	.join(' · ');

const lockRows = [
	{ label: t.product.rows.material, value: S.material[lock.material] },
	{ label: t.product.rows.access, value: accessValue },
	{ label: t.product.rows.temp, value: `${lock.temp.min} °C … +${lock.temp.max} °C` },
	{ label: t.product.rows.power, value: S.power[lock.power] },
	{ label: t.product.rows.battery, value: t.product.months(lock.battery) },
	...(lock.app ? [{ label: t.product.rows.app, value: lock.app }] : []),
	{
		label: t.product.rows.brand,
		value: `${brandNames[lock.brand]} / ${t.product.years(lock.warranty)}`,
	},
	...(lock.origin?.[lang] ? [{ label: t.product.rows.origin, value: lock.origin[lang] }] : []),
	...(lock.interface.length > 0
		? [{ label: t.product.rows.iface, value: lock.interface.map((i) => S.iface[i]).join(', ') }]
		: []),
	{ label: t.product.rows.colors, value: lock.colors.map((c) => S.color[c]).join(', ') },
];

const accessoryRows = [
	{
		label: t.product.rows.brand,
		value: `${brandNames[lock.brand]} / ${t.product.years(lock.warranty)}`,
	},
	...(lock.compatibility?.[lang] ? [{ label: t.product.rows.compatibility, value: lock.compatibility[lang] }] : []),
	...(lock.included?.[lang] ? [{ label: t.product.rows.included, value: lock.included[lang] }] : []),
	...(lock.interface.length > 0
		? [{ label: t.product.rows.iface, value: lock.interface.map((i) => S.iface[i]).join(', ') }]
		: []),
	...(lock.features.includes('rechargeable')
		? [
				{ label: t.product.rows.power, value: S.power[lock.power] },
				{ label: t.product.rows.battery, value: t.product.months(lock.battery) },
			]
		: []),
];

const rows = isAccessory ? accessoryRows : lockRows;
const additionalProperties = isAccessory
	? accessoryRows.map((row) => ({ '@type': 'PropertyValue', name: row.label, value: row.value }))
	: [
		{ '@type': 'PropertyValue', name: t.product.rows.material, value: S.material[lock.material] },
		{ '@type': 'PropertyValue', name: t.product.rows.access, value: accessValue },
		{ '@type': 'PropertyValue', name: t.product.rows.battery, value: t.product.months(lock.battery) },
	];

const siteUrl = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(canonicalPath(path), siteUrl).toString();
const canonical = abs(Astro.url.pathname);

const productLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: productName,
	description: lock.seoDescription,
	image: new URL(lock.image.src, siteUrl).toString(),
	sku: lock.slug,
	category: isAccessory ? t.catalog.accessories : t.catalog.title,
	brand: { '@type': 'Brand', name: brandNames[lock.brand] },
	offers: {
		...(hasColorPicker && new Set(colorOptions.map((o) => o.price)).size > 1
			? {
					'@type': 'AggregateOffer',
					lowPrice: Math.min(...colorOptions.map((o) => o.price)),
					highPrice: Math.max(...colorOptions.map((o) => o.price)),
					offerCount: colorOptions.length,
				}
			: { '@type': 'Offer', price: lock.price }),
		url: canonical,
		priceCurrency: 'KZT',
		availability: lock.comingSoon
			? 'https://schema.org/PreOrder'
			: 'https://schema.org/InStock',
		itemCondition: 'https://schema.org/NewCondition',
		seller: { '@type': 'Organization', name: 'iLOCK' },
	},
	additionalProperty: additionalProperties,
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'iLOCK', item: abs(homePath) },
		{ '@type': 'ListItem', position: 2, name: t.nav.catalog, item: abs(`${homePath}catalog/`) },
		{
			'@type': 'ListItem',
			position: 3,
			name: brandNames[lock.brand],
			item: abs(`${homePath}catalog/${lock.brand}/`),
		},
		{ '@type': 'ListItem', position: 4, name: lock.title, item: canonical },
	],
};
---

<section class="bg-main-color px-5 pb-10 pt-28 sm:px-8 sm:pb-14 sm:pt-32 lg:px-12">
	<div class="mx-auto max-w-7xl">
		<nav aria-label="breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-white/40">
			<a href={homePath} class="transition hover:text-accent-color">iLOCK</a>
			<span aria-hidden="true">/</span>
			<a href={`${homePath}catalog/`} class="transition hover:text-accent-color">
				{t.nav.catalog}
			</a>
			<span aria-hidden="true">/</span>
			<a href={`${homePath}catalog/${lock.brand}/`} class="transition hover:text-accent-color">
				{brandNames[lock.brand]}
			</a>
			<span aria-hidden="true">/</span>
			<span class="text-white/70">{lock.title}</span>
		</nav>

		<div class="mt-8 grid gap-8 lg:grid-cols-2 lg:gap-12">
			<div class="relative overflow-hidden rounded-3xl border border-line bg-linear-to-b from-[#d2d2d2] to-[#bdbdbd]">
				{
					colorImages.map((image) => {
						const isSelected = image.src === selected.image.src;
						return (
							<Image
								src={image}
								alt={t.product.imgAlt(brandNames[lock.brand], lock.title, lock.kind)}
								width={900}
								class:list={['aspect-square w-full object-contain p-8 sm:p-12', !isSelected && 'hidden']}
								loading={isSelected ? 'eager' : 'lazy'}
								fetchpriority={isSelected ? 'high' : undefined}
								data-color-image={image.src}
							/>
						);
					})
				}

				<div class="absolute left-4 top-4 flex flex-col items-start gap-2">
					{
						hasInstallationGift && (
							<span class="inline-flex items-center gap-1.5 rounded-full border border-amber-100/60 bg-linear-to-r from-fuchsia-600 via-violet-600 to-amber-500 px-3 py-1 text-[11px] font-bold tracking-wide text-white shadow-[0_0_28px_rgba(217,70,239,0.8)]">
								<span aria-hidden="true">✦</span>
								{promo.giftInstallation}
							</span>
						)
					}
					{
						lock.featured && !lock.comingSoon && (
							<span class="rounded-full bg-accent-color px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-main-color">
								{t.catalog.featured}
							</span>
						)
					}
					{
						lock.kazakhBrand && (
							<span class="rounded-full border border-white/20 bg-main-color/80 px-3 py-1 text-[11px] font-medium text-white/75">
								{t.catalog.kazakhBrand}
							</span>
						)
					}
				</div>
			</div>

			<div>
				<p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-accent-color">
					<span class="h-px w-8 bg-accent-color"></span>
					{brandNames[lock.brand]}
				</p>

				<h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
					{productName}
				</h1>

				<p class="mt-5 text-base leading-7 text-white/60 sm:text-lg sm:leading-8">{lock.description}</p>

				{
					hasColorPicker && (
						<fieldset class="mt-7" data-color-picker>
							<legend class="text-sm font-semibold uppercase tracking-[0.14em] text-white/45">
								{t.product.rows.colors}: <span class="normal-case tracking-normal text-white/80" data-color-name>{selected.name}</span>
							</legend>
							<div class="mt-3 flex flex-wrap gap-2">
								{colorOptions.map((option) => (
									<button
										type="button"
										aria-pressed={option.color === selected.color ? 'true' : 'false'}
										data-color-option
										data-name={option.name}
										data-price={formatPrice(option.price)}
										data-old-price={option.oldPrice ? formatPrice(option.oldPrice) : ''}
										data-kaspi={kaspiText(option.price)}
										data-order-href={orderHref(option.name)}
										data-image={option.image.src}
										class="inline-flex items-center gap-2.5 rounded-full border border-line bg-secondary-color py-1.5 pl-1.5 pr-4 text-sm text-white/75 transition hover:border-accent-color/60 aria-pressed:border-accent-color aria-pressed:bg-accent-color/10 aria-pressed:text-white"
									>
										<span
											class="h-7 w-7 shrink-0 rounded-full border border-white/25"
											style={`background: ${swatch[option.color]}`}
											aria-hidden="true"
										/>
										{option.name}
									</button>
								))}
							</div>
						</fieldset>
					)
				}

				<div class="mt-7">
					<p
						class:list={['mb-1 text-lg font-medium text-white/40 line-through', !selected.oldPrice && 'hidden']}
						data-color-old-price
					>
						{selected.oldPrice ? formatPrice(selected.oldPrice) : ''}
					</p>
					<p class="text-3xl font-semibold tracking-tight text-accent-color sm:text-4xl">
						{
							lock.priceTo && (
								<span class="mr-1.5 font-sans text-base font-normal text-white/40">{t.catalog.from}</span>
							)
						}
						<span data-color-price>{formatPrice(selected.price, lock.priceTo)}</span>
					</p>
				</div>

				{
					hasInstallationGift && (
						<p class="mt-3 inline-flex items-center gap-2 rounded-xl border border-fuchsia-400/50 bg-fuchsia-500/10 px-3.5 py-2 text-sm font-semibold text-fuchsia-100 shadow-[0_0_26px_rgba(217,70,239,0.22)]">
							<span class="text-base text-amber-300" aria-hidden="true">✦</span>
							{promo.giftInstallation}
						</p>
					)
				}

				<div class="mt-4 inline-flex items-center gap-2.5 rounded-xl bg-[#F14635] px-3.5 py-2">
					<span class="rounded-md bg-white px-1.5 py-0.5 text-[13px] font-extrabold leading-none text-[#F14635]">
						Kaspi
					</span>
					<span class="text-sm font-semibold text-white" data-color-kaspi>
						{kaspiText(selected.price)}
					</span>
				</div>

				{
					lock.kind === 'lock' && (
						<p class="mt-3 inline-flex items-center gap-2 rounded-xl border border-accent-color/35 bg-accent-color/10 px-3.5 py-2 text-sm font-semibold text-accent-color">
							<span class="rounded-md bg-accent-color px-1.5 py-0.5 text-xs font-extrabold text-main-color">₸</span>
							{t.product.installment24}
						</p>
					)
				}

				<div class="mt-7">
					<a
						href={orderHref(selected.color ? selected.name : undefined)}
						data-color-order
						target="_blank"
						rel="noopener"
						class="inline-flex h-14 w-full items-center justify-center rounded-full bg-accent-color px-10 text-base font-semibold text-main-color transition hover:bg-accent-soft sm:w-auto"
					>
						{t.product.order}
					</a>
				</div>

				{
					lock.access.length > 0 && (
						<div class="mt-9">
					<h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-white/45">{t.product.access}</h2>
					<ul class="mt-4 flex flex-wrap gap-2">
						{
							lock.access.map((a) => (
								<li class="rounded-full border border-accent-color/30 bg-accent-color/5 px-3.5 py-1.5 text-sm text-white/80">
									{S.access[a]}
									{lock.limits?.[a] && <span class="ml-1 text-white/40">{lock.limits[a]}</span>}
								</li>
							))
						}
					</ul>
						</div>
					)
				}

				{
					lock.features.length > 0 && (
						<div class="mt-7">
							<h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-white/45">
								{lock.kind === 'safe'
									? t.product.safeFeatures
									: isAccessory
										? t.product.accessoryFeatures
										: t.product.features}
							</h2>
							<ul class="mt-4 grid gap-2 sm:grid-cols-2">
								{lock.features.map((f) => (
									<li class="flex items-start gap-2.5 text-sm leading-6 text-white/70">
										<svg
											viewBox="0 0 24 24"
											class="mt-1 h-4 w-4 shrink-0 text-accent-color"
											fill="none"
											stroke="currentColor"
											stroke-width="2.4"
											aria-hidden="true"
										>
											<path d="m4 12.5 5 5L20 6.5" />
										</svg>
										{S.feature[f]}
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</div>

		{
			lock.variants.length > 0 && (
				<div class="mt-14 overflow-hidden rounded-2xl border border-line lg:mt-20">
					<h2 class="border-b border-line bg-secondary-color px-6 py-4 text-lg font-semibold">
						{t.product.variants}
					</h2>
					<div class="overflow-x-auto">
						<table class="w-full min-w-[680px] text-left text-sm">
							<thead class="bg-main-color text-white/45">
								<tr>
									<th class="px-6 py-3 font-medium">{t.product.variantModel}</th>
									<th class="px-6 py-3 font-medium">{t.product.variantPrice}</th>
									<th class="px-6 py-3 font-medium">{t.product.variantDimensions}</th>
									<th class="px-6 py-3 font-medium">{t.product.variantWeight}</th>
								</tr>
							</thead>
							<tbody>
								{lock.variants.map((variant, i) => (
									<tr class:list={[i % 2 === 0 ? 'bg-secondary-color/60' : 'bg-main-color']}>
										<td class="px-6 py-4 text-white/85">{variant.name}</td>
										<td class="px-6 py-4 font-semibold text-accent-color">{formatPrice(variant.price)}</td>
										<td class="px-6 py-4 text-white/70">
											{variant.height && variant.width && variant.depth
												? `${variant.height} × ${variant.width} × ${variant.depth} см`
												: '—'}
										</td>
										<td class="px-6 py-4 text-white/70">
											{variant.weight ? `${variant.weight} кг` : '—'}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			)
		}

		<div class="mt-14 grid gap-8 lg:mt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
			<div>
				<h2 class="text-2xl font-bold sm:text-3xl">{t.product.about}</h2>
				<p class="mt-5 text-base leading-8 text-white/60">{lock.body}</p>
			</div>

			<div class="overflow-hidden rounded-2xl border border-line">
				<h2 class="border-b border-line bg-secondary-color px-6 py-4 text-lg font-semibold">
					{t.product.specs}
				</h2>
				<dl>
					{
						rows.map((row, i) => (
							<div
								class:list={[
									'grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] sm:gap-6',
									i % 2 === 0 ? 'bg-main-color' : 'bg-secondary-color/60',
								]}
							>
								<dt class="text-sm text-white/40">{row.label}</dt>
								<dd class="text-sm leading-6 text-white/85">{row.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>

		{
			related.length > 0 && (
				<div class="mt-16 sm:mt-24">
					<div class="flex items-end justify-between gap-4">
						<h2 class="text-2xl font-bold sm:text-3xl">{t.product.related}</h2>
						<a
							href={`${homePath}catalog/`}
							class="shrink-0 text-sm text-accent-color transition hover:text-accent-soft"
						>
							{t.product.others} →
						</a>
					</div>
					<div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
						{related.map((item) => (
							<LockCard lock={item} lang={lang} />
						))}
					</div>
				</div>
			)
		}
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(productLd)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />

<script>
	// Colour picker: every value a colour changes is rendered into its button's data-*.
	const picker = document.querySelector<HTMLElement>('[data-color-picker]');
	const buttons = [...(picker?.querySelectorAll<HTMLButtonElement>('[data-color-option]') ?? [])];
	const setText = (selector: string, value = '') => {
		const el = document.querySelector<HTMLElement>(selector);
		if (el) el.textContent = value;
	};

	for (const button of buttons) {
		button.addEventListener('click', () => {
			const d = button.dataset;
			for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
			setText('[data-color-name]', d.name);
			setText('[data-color-price]', d.price);
			setText('[data-color-kaspi]', d.kaspi);
			const oldPrice = document.querySelector<HTMLElement>('[data-color-old-price]');
			if (oldPrice) {
				oldPrice.textContent = d.oldPrice ?? '';
				oldPrice.classList.toggle('hidden', !d.oldPrice);
			}
			const order = document.querySelector<HTMLAnchorElement>('[data-color-order]');
			if (order && d.orderHref) order.href = d.orderHref;
			for (const img of document.querySelectorAll<HTMLImageElement>('[data-color-image]')) {
				img.classList.toggle('hidden', img.dataset.colorImage !== d.image);
			}
		});
	}
</script>
