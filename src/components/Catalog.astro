---
import { getCollection } from 'astro:content';
import LockCard from './LockCard.astro';
import { lockFilterValues } from '../lib/lock-filters';
import {
	brandNames,
	brandOrder,
	canonicalPath,
	getLocalePath,
	localizeLock,
	sortLocks,
	type Lang,
	ui,
} from '../i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
const f = t.catalogFilters;
const homePath = getLocalePath(lang);

const locks = sortLocks((await getCollection('locks')).map((lock) => localizeLock(lock, lang)));

const groups = brandOrder
	.map((brand) => {
		const brandLocks = locks.filter((lock) => lock.brand === brand);
		return {
			brand,
			count: brandLocks.length,
			kinds: [...new Set(brandLocks.map((lock) => lock.kind))],
		};
	})
	.filter((g) => g.count > 0);

const kinds = ['lock', 'safe', 'accessory'] as const;

const categoryTabs = [
	{ kind: 'lock', label: t.catalog.smartLocks, count: locks.filter((lock) => lock.kind === 'lock').length },
	{ kind: 'safe', label: t.catalog.safes, count: locks.filter((lock) => lock.kind === 'safe').length },
	{ kind: 'accessory', label: t.catalog.accessories, count: locks.filter((lock) => lock.kind === 'accessory').length },
];

/** Price slider bounds per category, so the inputs hint at the range that actually exists. */
const priceBounds = Object.fromEntries(
	kinds.map((kind) => {
		const prices = locks.filter((lock) => lock.kind === kind).map((lock) => lock.price);
		return [kind, prices.length ? { min: Math.min(...prices), max: Math.max(...prices) } : { min: 0, max: 0 }];
	}),
);

/** Starting counts next to each checkbox; the client recomputes them as filters are applied. */
const optionCounts: Record<string, number> = {};
locks
	.filter((lock) => lock.kind === 'lock')
	.forEach((lock) => {
		lockFilterValues(lock).forEach((value) => {
			optionCounts[value] = (optionCounts[value] ?? 0) + 1;
		});
	});

/** Plural forms for every reachable result count — the client script has no access to `ui`. */
const countForms = Array.from({ length: locks.length + 1 }, (_, n) => t.brandPage.models(n));

const siteUrl = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(canonicalPath(path), siteUrl).toString();

const itemListLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: t.catalogPage.h1,
	numberOfItems: locks.length,
	itemListElement: locks.map((lock, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'Product',
			name: t.product.h1(brandNames[lock.brand], lock.title, lock.kind),
			description: lock.description,
			brand: { '@type': 'Brand', name: brandNames[lock.brand] },
			url: abs(`${homePath}catalog/${lock.slug}/`),
			offers: {
				'@type': 'Offer',
				price: lock.price,
				priceCurrency: 'KZT',
				availability: lock.comingSoon
					? 'https://schema.org/PreOrder'
					: 'https://schema.org/InStock',
			},
		},
	})),
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'iLOCK', item: abs(homePath) },
		{
			'@type': 'ListItem',
			position: 2,
			name: t.nav.catalog,
			item: abs(`${homePath}catalog/`),
		},
	],
};
---

<section id="catalog" class="bg-main-color px-5 pb-10 pt-28 sm:px-8 sm:pb-14 sm:pt-32 lg:px-12">
	<div class="mx-auto max-w-7xl">
		<nav aria-label="breadcrumb" class="flex items-center gap-2 text-sm text-white/40">
			<a href={homePath} class="transition hover:text-accent-color">iLOCK</a>
			<span aria-hidden="true">/</span>
			<span class="text-white/70">{t.catalog.eyebrow}</span>
		</nav>

		<div class="mt-8 max-w-3xl">
			<p
				class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-accent-color sm:text-sm"
			>
				<span class="h-px w-8 shrink-0 bg-accent-color sm:w-12"></span>
				{t.catalog.eyebrow}
			</p>
			<h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">
				{t.catalogPage.h1}
			</h1>
			<p class="mt-6 text-base leading-7 text-white/60 sm:text-lg sm:leading-8">{t.catalogPage.lead}</p>
		</div>

		<p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/35">
			<span>{t.footer.brands}:</span>
			{
				groups.map((group) => (
					<a
						href={`${homePath}catalog/${group.brand}/`}
						data-brand-link
						data-brand-kinds={group.kinds.join(' ')}
						class="text-white/60 underline decoration-line underline-offset-4 transition hover:text-accent-color hover:decoration-accent-color"
					>
						{t.brandPage[group.brand].h1}
					</a>
				))
			}
		</p>

		<div class="mt-8 lg:grid lg:grid-cols-[16.5rem_1fr] lg:items-start lg:gap-7 xl:grid-cols-[18rem_1fr] xl:gap-9">
			<div data-filter-backdrop data-open="false" class="filter-backdrop lg:hidden"></div>

			<aside data-filter-panel data-open="false" aria-label={f.title} class="filter-panel">
				<div class="flex items-center justify-between gap-3 border-b border-line px-5 py-4 lg:px-4 lg:py-3.5">
					<h2 class="text-base font-semibold text-white">{f.title}</h2>
					<button
						type="button"
						data-filter-reset
						class="hidden rounded-full px-2.5 py-1 text-sm font-medium text-white/45 transition hover:bg-accent-color/10 hover:text-accent-color lg:block"
					>
						{f.reset}
					</button>
					<button
						type="button"
						data-filter-close
						aria-label={f.close}
						class="-mr-1.5 flex h-9 w-9 items-center justify-center rounded-full text-xl text-white/55 transition hover:bg-white/5 hover:text-white lg:hidden"
					>
						✕
					</button>
				</div>

				<div class="filter-scroll grid gap-5 px-5 py-5 lg:px-4 lg:py-4">
					<label class="block">
						<span class="sr-only">{f.search}</span>
						<input
							type="search"
							data-lock-search
							placeholder={f.searchPlaceholder}
							class="h-11 w-full rounded-xl border border-line bg-main-color/60 px-3.5 text-sm text-white placeholder:text-white/32 transition focus:border-accent-color focus:outline-none"
						/>
					</label>

					<section aria-labelledby="facet-category">
						<h3 id="facet-category" class="facet-title">{f.category}</h3>
						<div role="radiogroup" aria-labelledby="facet-category" class="mt-2 grid gap-0.5">
							{
								categoryTabs.map((category, i) => (
									<button
										type="button"
										role="radio"
										data-kind-filter={category.kind}
										aria-checked={i === 0}
										class="facet-row"
									>
										<span>{category.label}</span>
										<span class="facet-count">{category.count}</span>
									</button>
								))
							}
						</div>
					</section>

					<section aria-labelledby="facet-brand">
						<h3 id="facet-brand" class="facet-title">{f.brand}</h3>
						<div role="radiogroup" aria-labelledby="facet-brand" class="mt-2 grid gap-0.5">
							<button type="button" role="radio" data-brand-filter="all" aria-checked="true" class="facet-row">
								<span>{f.allBrands}</span>
								<span class="facet-count" data-brand-count></span>
							</button>
							{
								groups.map((group) => (
									<button
										type="button"
										role="radio"
										data-brand-filter={group.brand}
										data-brand-kinds={group.kinds.join(' ')}
										aria-checked="false"
										class="facet-row"
									>
										<span>{brandNames[group.brand]}</span>
										<span class="facet-count" data-brand-count />
									</button>
								))
							}
						</div>
					</section>

					<section aria-labelledby="facet-price">
						<h3 id="facet-price" class="facet-title">{f.price}</h3>
						<div class="mt-2 grid grid-cols-2 gap-2">
							<label class="price-field">
								<span>{f.from}</span>
								<input type="number" inputmode="numeric" min="0" data-price-min />
							</label>
							<label class="price-field">
								<span>{f.to}</span>
								<input type="number" inputmode="numeric" min="0" data-price-max />
							</label>
						</div>
					</section>

					<div data-spec-groups class="grid gap-2">
						{
							f.groups.map((group) => (
								<details class="filter-group" open>
									<summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 py-1 text-sm font-semibold text-white/78 transition hover:text-white">
										<span>{group.title}</span>
										<span class="filter-chevron text-white/35 transition" aria-hidden="true">
											⌄
										</span>
									</summary>
									<fieldset class="grid gap-0.5 pb-1">
										<legend class="sr-only">{group.title}</legend>
										{group.options.map((option) => (
											<label class="filter-check">
												<input
													type="checkbox"
													data-lock-filter={option.value}
													data-label={option.label}
													class="h-4 w-4 shrink-0 accent-accent-color"
												/>
												<span class="flex-1">{option.label}</span>
												<span class="facet-count" data-option-count={option.value}>
													{optionCounts[option.value] ?? 0}
												</span>
											</label>
										))}
									</fieldset>
								</details>
							))
						}
					</div>
				</div>

				<div
					class="flex items-center gap-3 border-t border-line px-5 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] lg:hidden"
				>
					<button
						type="button"
						data-filter-reset
						class="h-12 shrink-0 rounded-full border border-line px-5 text-sm font-medium text-white/60 transition hover:border-accent-color/45 hover:text-white"
					>
						{f.reset}
					</button>
					<button
						type="button"
						data-filter-apply
						class="h-12 flex-1 rounded-full bg-accent-color px-5 text-sm font-semibold text-main-color transition hover:bg-accent-soft"
					>
					</button>
				</div>
			</aside>

			<div class="min-w-0">
				<div
					class="sticky top-16 z-30 -mx-5 flex items-center gap-2 border-b border-line/70 bg-main-color/95 px-5 py-3 backdrop-blur sm:-mx-8 sm:px-8 sm:top-20 lg:static lg:mx-0 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none"
				>
					<button
						type="button"
						data-filter-open
						class="inline-flex h-11 shrink-0 items-center gap-2 rounded-full border border-line bg-secondary-color px-4 text-sm font-semibold text-white transition hover:border-accent-color/45 lg:hidden"
					>
						<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="h-4 w-4">
							<path
								d="M3 5.5h14M6 10h8M8.5 14.5h3"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"></path>
						</svg>
						{f.title}
						<span
							data-filter-count
							hidden
							class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-accent-color px-1.5 text-xs font-bold text-main-color"
						>
						</span>
					</button>

					<p data-found class="hidden text-sm text-white/45 lg:block"></p>

					<label class="ml-auto flex items-center gap-2">
						<span class="hidden text-sm text-white/40 lg:inline">{f.sort}</span>
						<span class="sr-only lg:hidden">{f.sort}</span>
						<span class="relative">
							<select data-sort class="sort-select">
								{
									f.sortOptions.map((option) => (
										<option value={option.value} class="bg-secondary-color">
											{option.label}
										</option>
									))
								}
							</select>
							<span
								aria-hidden="true"
								class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-white/40">⌄</span
							>
						</span>
					</label>
				</div>

				<div data-chips class="mt-4 hidden flex-wrap items-center gap-2"></div>

				<template data-chip-template
					><button type="button" class="filter-chip"
						><span data-chip-label></span><span aria-hidden="true" class="text-white/50">✕</span></button
					></template
				>
				<template data-clear-template
					><button type="button" class="filter-chip is-clear" data-chip-type="all"></button></template
				>

				<div data-lock-grid class="mt-5 grid gap-4 sm:grid-cols-2 sm:gap-5 xl:grid-cols-3">
					{locks.map((lock, i) => <LockCard lock={lock} lang={lang} eager={i < 3} />)}
				</div>

				<p data-empty hidden class="mt-12 text-center text-white/45">{t.catalog.empty}</p>
			</div>
		</div>
	</div>
</section>

<script
	type="application/json"
	data-catalog-config
	is:inline
	set:html={JSON.stringify({ priceBounds, countForms, found: f.found, show: f.show, resetAll: f.resetAll, from: f.from, to: f.to, brandNames })}
/>

<script type="application/ld+json" set:html={JSON.stringify(itemListLd)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />

<script>
	type Config = {
		priceBounds: Record<string, { min: number; max: number }>;
		countForms: string[];
		found: string;
		show: string;
		resetAll: string;
		from: string;
		to: string;
		brandNames: Record<string, string>;
	};

	const configEl = document.querySelector('[data-catalog-config]');
	const cfg: Config = JSON.parse(configEl?.textContent ?? '{}');

	const panel = document.querySelector<HTMLElement>('[data-filter-panel]');
	const backdrop = document.querySelector<HTMLElement>('[data-filter-backdrop]');
	const openButton = document.querySelector<HTMLButtonElement>('[data-filter-open]');
	const closeButton = document.querySelector<HTMLButtonElement>('[data-filter-close]');
	const applyButton = document.querySelector<HTMLButtonElement>('[data-filter-apply]');
	const resetButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-reset]');
	const kindButtons = document.querySelectorAll<HTMLButtonElement>('[data-kind-filter]');
	const brandButtons = document.querySelectorAll<HTMLButtonElement>('[data-brand-filter]');
	const brandLinks = document.querySelectorAll<HTMLElement>('[data-brand-link]');
	const checkboxes = document.querySelectorAll<HTMLInputElement>('[data-lock-filter]');
	const specGroups = document.querySelector<HTMLElement>('[data-spec-groups]');
	const search = document.querySelector<HTMLInputElement>('[data-lock-search]');
	const priceMin = document.querySelector<HTMLInputElement>('[data-price-min]');
	const priceMax = document.querySelector<HTMLInputElement>('[data-price-max]');
	const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
	const chips = document.querySelector<HTMLElement>('[data-chips]');
	const chipTemplate = document.querySelector<HTMLTemplateElement>('[data-chip-template]');
	const clearTemplate = document.querySelector<HTMLTemplateElement>('[data-clear-template]');
	const foundLabel = document.querySelector<HTMLElement>('[data-found]');
	const filterCount = document.querySelector<HTMLElement>('[data-filter-count]');
	const empty = document.querySelector<HTMLElement>('[data-empty]');

	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-lock-grid] .lock-card')).map(
		(el, index) => ({
			el,
			index,
			kind: el.dataset.kind ?? '',
			brand: el.dataset.brand ?? '',
			price: Number(el.dataset.price ?? 0),
			title: el.dataset.title ?? '',
			search: el.dataset.searchName ?? '',
			values: new Set((el.dataset.filterValues ?? '').split(' ').filter(Boolean)),
		}),
	);

	const requestedKind = new URLSearchParams(window.location.search).get('kind');
	const state = {
		kind: ['lock', 'safe', 'accessory'].includes(requestedKind ?? '') ? requestedKind! : 'lock',
		brand: 'all',
		query: '',
		min: null as number | null,
		max: null as number | null,
		sort: 'default',
	};

	const desktop = window.matchMedia('(min-width: 1024px)');
	const numberFormat = new Intl.NumberFormat(document.documentElement.lang === 'en' ? 'en-US' : 'ru-RU');
	const plural = (n: number) => cfg.countForms?.[n] ?? String(n);

	/** Checked options grouped by their prefix — OR inside a group, AND between groups. */
	const checkedGroups = () => {
		const map = new Map<string, string[]>();
		if (state.kind !== 'lock') return map;
		checkboxes.forEach((input) => {
			if (!input.checked) return;
			const value = input.dataset.lockFilter ?? '';
			const group = value.split('-')[0];
			if (!value || !group) return;
			map.set(group, [...(map.get(group) ?? []), value]);
		});
		return map;
	};

	type Item = (typeof items)[number];
	type Skip = { brand?: boolean; group?: string };

	const matches = (item: Item, active: Map<string, string[]>, skip: Skip = {}) => {
		if (item.kind !== state.kind) return false;
		if (!skip.brand && state.brand !== 'all' && item.brand !== state.brand) return false;
		if (state.query && !item.search.includes(state.query)) return false;
		if (state.min !== null && item.price < state.min) return false;
		if (state.max !== null && item.price > state.max) return false;
		for (const [group, values] of active) {
			if (group === skip.group) continue;
			if (!values.some((value) => item.values.has(value))) return false;
		}
		return true;
	};

	const compare = (a: Item, b: Item) => {
		if (state.sort === 'price-asc') return a.price - b.price || a.index - b.index;
		if (state.sort === 'price-desc') return b.price - a.price || a.index - b.index;
		if (state.sort === 'name') return a.title.localeCompare(b.title);
		return a.index - b.index;
	};

	const activeChips = (active: Map<string, string[]>) => {
		const list: { type: string; value: string; label: string }[] = [];
		if (state.brand !== 'all') {
			list.push({ type: 'brand', value: state.brand, label: cfg.brandNames?.[state.brand] ?? state.brand });
		}
		if (state.min !== null) {
			list.push({ type: 'min', value: '', label: `${cfg.from} ${numberFormat.format(state.min)} ₸` });
		}
		if (state.max !== null) {
			list.push({ type: 'max', value: '', label: `${cfg.to} ${numberFormat.format(state.max)} ₸` });
		}
		if (state.query) list.push({ type: 'query', value: '', label: `«${state.query}»` });
		active.forEach((values) =>
			values.forEach((value) => {
				const input = document.querySelector<HTMLInputElement>(`[data-lock-filter="${value}"]`);
				list.push({ type: 'option', value, label: input?.dataset.label ?? value });
			}),
		);
		return list;
	};

	const render = () => {
		const active = checkedGroups();

		kindButtons.forEach((button) => {
			button.setAttribute('aria-checked', String(button.dataset.kindFilter === state.kind));
		});

		brandButtons.forEach((button) => {
			const brand = button.dataset.brandFilter ?? 'all';
			const brandKinds = button.dataset.brandKinds?.split(' ') ?? [];
			const available = brand === 'all' || brandKinds.includes(state.kind);
			button.hidden = !available;
			button.setAttribute('aria-checked', String(available && brand === state.brand));
			const count = items.filter(
				(item) => matches(item, active, { brand: true }) && (brand === 'all' || item.brand === brand),
			).length;
			const countEl = button.querySelector<HTMLElement>('[data-brand-count]');
			if (countEl) countEl.textContent = String(count);
		});

		brandLinks.forEach((link) => {
			link.hidden = !(link.dataset.brandKinds?.split(' ') ?? []).includes(state.kind);
		});

		if (specGroups) specGroups.hidden = state.kind !== 'lock';

		const bounds = cfg.priceBounds?.[state.kind];
		if (priceMin) priceMin.placeholder = bounds ? numberFormat.format(bounds.min) : '';
		if (priceMax) priceMax.placeholder = bounds ? numberFormat.format(bounds.max) : '';

		let shown = 0;
		items.forEach((item) => {
			const match = matches(item, active);
			item.el.hidden = !match;
			if (match) shown += 1;
		});

		items
			.filter((item) => !item.el.hidden)
			.sort(compare)
			.forEach((item, position) => {
				item.el.style.order = String(position);
			});

		checkboxes.forEach((input) => {
			const value = input.dataset.lockFilter ?? '';
			const group = value.split('-')[0];
			const count = items.filter(
				(item) => matches(item, active, { group }) && item.values.has(value),
			).length;
			const countEl = document.querySelector<HTMLElement>(`[data-option-count="${value}"]`);
			if (countEl) countEl.textContent = String(count);
			const label = input.closest('label');
			label?.classList.toggle('is-muted', count === 0 && !input.checked);
		});

		const chipList = activeChips(active);
		if (chips) {
			chips.innerHTML = '';
			chipList.forEach((chip) => {
				const node = chipTemplate?.content.cloneNode(true) as DocumentFragment | undefined;
				const button = node?.querySelector('button');
				if (!button) return;
				button.dataset.chipType = chip.type;
				button.dataset.chipValue = chip.value;
				const label = button.querySelector('[data-chip-label]');
				if (label) label.textContent = chip.label;
				chips.append(button);
			});
			if (chipList.length > 0) {
				const node = clearTemplate?.content.cloneNode(true) as DocumentFragment | undefined;
				const clear = node?.querySelector('button');
				if (clear) {
					clear.textContent = cfg.resetAll;
					chips.append(clear);
				}
			}
			chips.classList.toggle('hidden', chipList.length === 0);
			chips.classList.toggle('flex', chipList.length > 0);
		}

		if (filterCount) {
			filterCount.textContent = String(chipList.length);
			filterCount.hidden = chipList.length === 0;
		}
		resetButtons.forEach((button) => {
			button.disabled = chipList.length === 0;
		});

		if (foundLabel) foundLabel.textContent = `${cfg.found}: ${plural(shown)}`;
		if (applyButton) applyButton.textContent = `${cfg.show} (${shown})`;
		if (empty) empty.hidden = shown > 0;
	};

	const setSheet = (open: boolean) => {
		if (!panel) return;
		const sheet = open && !desktop.matches;
		panel.dataset.open = String(sheet);
		panel.inert = !desktop.matches && !sheet;
		if (backdrop) backdrop.dataset.open = String(sheet);
		document.body.style.overflow = sheet ? 'hidden' : '';
		if (sheet) closeButton?.focus();
	};

	const resetAll = () => {
		checkboxes.forEach((input) => {
			input.checked = false;
		});
		if (search) search.value = '';
		if (priceMin) priceMin.value = '';
		if (priceMax) priceMax.value = '';
		state.brand = 'all';
		state.query = '';
		state.min = null;
		state.max = null;
		render();
	};

	kindButtons.forEach((button) =>
		button.addEventListener('click', () => {
			state.kind = button.dataset.kindFilter ?? 'lock';
			state.brand = 'all';
			state.min = null;
			state.max = null;
			if (priceMin) priceMin.value = '';
			if (priceMax) priceMax.value = '';
			render();
		}),
	);

	brandButtons.forEach((button) =>
		button.addEventListener('click', () => {
			state.brand = button.dataset.brandFilter ?? 'all';
			render();
		}),
	);

	checkboxes.forEach((input) => input.addEventListener('change', render));

	search?.addEventListener('input', () => {
		state.query = search.value.trim().toLowerCase();
		render();
	});

	const readPrice = (input: HTMLInputElement | null) => {
		const value = Number(input?.value);
		return input?.value && Number.isFinite(value) && value > 0 ? value : null;
	};

	priceMin?.addEventListener('input', () => {
		state.min = readPrice(priceMin);
		render();
	});
	priceMax?.addEventListener('input', () => {
		state.max = readPrice(priceMax);
		render();
	});

	sortSelect?.addEventListener('change', () => {
		state.sort = sortSelect.value;
		render();
	});

	chips?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLElement>('[data-chip-type]');
		if (!button) return;
		const { chipType, chipValue } = button.dataset;
		if (chipType === 'all') return resetAll();
		if (chipType === 'brand') state.brand = 'all';
		if (chipType === 'min') {
			state.min = null;
			if (priceMin) priceMin.value = '';
		}
		if (chipType === 'max') {
			state.max = null;
			if (priceMax) priceMax.value = '';
		}
		if (chipType === 'query') {
			state.query = '';
			if (search) search.value = '';
		}
		if (chipType === 'option') {
			const input = document.querySelector<HTMLInputElement>(`[data-lock-filter="${chipValue}"]`);
			if (input) input.checked = false;
		}
		render();
	});

	resetButtons.forEach((button) => button.addEventListener('click', resetAll));
	openButton?.addEventListener('click', () => setSheet(true));
	closeButton?.addEventListener('click', () => setSheet(false));
	applyButton?.addEventListener('click', () => setSheet(false));
	backdrop?.addEventListener('click', () => setSheet(false));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && panel?.dataset.open === 'true') setSheet(false);
	});
	desktop.addEventListener('change', () => setSheet(false));

	setSheet(false);
	render();
</script>

