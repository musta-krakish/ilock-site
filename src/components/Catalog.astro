---
import { getCollection } from 'astro:content';
import LockCard from './LockCard.astro';
import {
	brandNames,
	brandOrder,
	canonicalPath,
	getLocalePath,
	localizeLock,
	sortLocks,
	type Lang,
	ui,
} from '../i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
const homePath = getLocalePath(lang);

const locks = sortLocks((await getCollection('locks')).map((lock) => localizeLock(lock, lang)));

const groups = brandOrder
	.map((brand) => {
		const brandLocks = locks.filter((lock) => lock.brand === brand);
		return {
			brand,
			count: brandLocks.length,
			kinds: [...new Set(brandLocks.map((lock) => lock.kind))],
		};
	})
	.filter((g) => g.count > 0);

const categoryTabs = [
	{ kind: 'lock', label: t.catalog.smartLocks, count: locks.filter((lock) => lock.kind === 'lock').length },
	{ kind: 'safe', label: t.catalog.safes, count: locks.filter((lock) => lock.kind === 'safe').length },
	{ kind: 'accessory', label: t.catalog.accessories, count: locks.filter((lock) => lock.kind === 'accessory').length },
];

const siteUrl = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(canonicalPath(path), siteUrl).toString();

const itemListLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: t.catalogPage.h1,
	numberOfItems: locks.length,
	itemListElement: locks.map((lock, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'Product',
			name: t.product.h1(brandNames[lock.brand], lock.title, lock.kind),
			description: lock.description,
			brand: { '@type': 'Brand', name: brandNames[lock.brand] },
			url: abs(`${homePath}catalog/${lock.slug}/`),
			offers: {
				'@type': 'Offer',
				price: lock.price,
				priceCurrency: 'KZT',
				availability: lock.comingSoon
					? 'https://schema.org/PreOrder'
					: 'https://schema.org/InStock',
			},
		},
	})),
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'iLOCK', item: abs(homePath) },
		{
			'@type': 'ListItem',
			position: 2,
			name: t.nav.catalog,
			item: abs(`${homePath}catalog/`),
		},
	],
};
---

<section id="catalog" class="bg-main-color px-5 pb-10 pt-28 sm:px-8 sm:pb-14 sm:pt-32 lg:px-12">
	<div class="mx-auto max-w-7xl">
		<nav aria-label="breadcrumb" class="flex items-center gap-2 text-sm text-white/40">
			<a href={homePath} class="transition hover:text-accent-color">iLOCK</a>
			<span aria-hidden="true">/</span>
			<span class="text-white/70">{t.catalog.eyebrow}</span>
		</nav>

		<div class="mt-8 max-w-3xl">
			<p
				class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-accent-color sm:text-sm"
			>
				<span class="h-px w-8 shrink-0 bg-accent-color sm:w-12"></span>
				{t.catalog.eyebrow}
			</p>
			<h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">
				{t.catalogPage.h1}
			</h1>
			<p class="mt-6 text-base leading-7 text-white/60 sm:text-lg sm:leading-8">{t.catalogPage.lead}</p>
		</div>

		<div class="mt-10 grid gap-3 sm:grid-cols-2 sm:gap-4" role="tablist" aria-label={t.catalog.categories}>
			{
				categoryTabs.map((category, i) => (
					<button
						type="button"
						role="tab"
						data-kind-filter={category.kind}
						aria-selected={i === 0}
						class="category-tab rounded-2xl border border-line bg-secondary-color px-6 py-5 text-left transition sm:px-7 sm:py-6"
					>
						<span class="block text-xl font-semibold text-white sm:text-2xl">{category.label}</span>
						<span class="mt-2 block text-sm text-white/40">{t.brandPage.models(category.count)}</span>
					</button>
				))
			}
		</div>

		<div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label={t.footer.brands}>
			<button
				type="button"
				role="tab"
				data-brand-filter="all"
				aria-selected="true"
				class="filter-tab rounded-full border border-line px-5 py-2.5 text-sm font-medium text-white/60 transition"
			>
				{t.catalog.all}
			</button>
			{
				groups.map((group) => (
					<button
						type="button"
						role="tab"
						data-brand-filter={group.brand}
						data-brand-kinds={group.kinds.join(' ')}
						aria-selected="false"
						class="filter-tab rounded-full border border-line px-5 py-2.5 text-sm font-medium text-white/60 transition"
					>
						{brandNames[group.brand]}
						<span class="ml-1.5 text-xs text-white/35">{group.count}</span>
					</button>
				))
			}
		</div>

		<p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/35">
			<span>{t.footer.brands}:</span>
			{
				groups.map((group) => (
					<a
						href={`${homePath}catalog/${group.brand}/`}
						data-brand-link
						data-brand-kinds={group.kinds.join(' ')}
						class="text-white/60 underline decoration-line underline-offset-4 transition hover:text-accent-color hover:decoration-accent-color"
					>
						{t.brandPage[group.brand].h1}
					</a>
				))
			}
		</p>

		<div
			data-lock-filters
			class="mt-7 rounded-2xl border border-line bg-secondary-color/55 p-4 sm:p-5"
		>
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="text-base font-semibold text-white">{t.catalogFilters.title}</h2>
				<button
					type="button"
					data-filter-reset
					class="rounded-full px-3 py-1.5 text-sm font-medium text-white/45 transition hover:bg-accent-color/10 hover:text-accent-color"
				>
					{t.catalogFilters.reset}
				</button>
			</div>

			<label class="mt-4 block">
				<span class="sr-only">{t.catalogFilters.search}</span>
				<input
					type="search"
					data-lock-search
					placeholder={t.catalogFilters.searchPlaceholder}
					class="h-12 w-full rounded-xl border border-line bg-main-color/60 px-4 text-sm text-white placeholder:text-white/32 transition focus:border-accent-color focus:outline-none"
				/>
			</label>

			<div class="mt-4 grid gap-2 md:grid-cols-2 xl:grid-cols-5">
				{
						t.catalogFilters.groups.map((group) => (
							<details class="filter-group min-w-0 rounded-xl border border-line bg-main-color/35">
							<summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-white/78 transition hover:text-white">
								<span>{group.title}</span>
								<span class="filter-chevron text-white/35 transition" aria-hidden="true">⌄</span>
							</summary>
							<fieldset class="grid gap-1.5 px-2.5 pb-3">
								<legend class="sr-only">{group.title}</legend>
								{group.options.map((option) => (
									<label class="filter-check flex min-h-10 items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm leading-5 text-white/62 transition hover:bg-white/[0.04] hover:text-white">
										<input
											type="checkbox"
											data-lock-filter={option.value}
											class="h-4 w-4 shrink-0 accent-accent-color"
										/>
										<span>{option.label}</span>
									</label>
								))}
							</fieldset>
						</details>
					))
				}
			</div>
		</div>

		<div data-lock-grid class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
			{locks.map((lock, i) => <LockCard lock={lock} lang={lang} eager={i < 3} />)}
		</div>

		<p data-empty hidden class="mt-12 text-center text-white/45">{t.catalog.empty}</p>
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(itemListLd)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />

<script>
	const categoryTabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
	const brandTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
	const brandLinks = document.querySelectorAll<HTMLElement>('[data-brand-link]');
	const lockFilters = document.querySelector<HTMLElement>('[data-lock-filters]');
	const lockFilterInputs = document.querySelectorAll<HTMLInputElement>('[data-lock-filter]');
	const search = document.querySelector<HTMLInputElement>('[data-lock-search]');
	const reset = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
	const cards = document.querySelectorAll<HTMLElement>('[data-lock-grid] .lock-card');
	const empty = document.querySelector<HTMLElement>('[data-empty]');
	const requestedKind = new URLSearchParams(window.location.search).get('kind');
	let activeKind = ['lock', 'safe', 'accessory'].includes(requestedKind ?? '') ? requestedKind! : 'lock';
	let activeBrand = 'all';

	const getActiveFilters = () => {
		const groups = new Map<string, string[]>();
		lockFilterInputs.forEach((input) => {
			if (!input.checked) return;
			const value = input.dataset.lockFilter;
			const group = value?.split('-')[0];
			if (!value || !group) return;
			groups.set(group, [...(groups.get(group) ?? []), value]);
		});
		return groups;
	};

	const render = () => {
		const activeFilters = activeKind === 'lock' ? getActiveFilters() : new Map<string, string[]>();
		const query = activeKind === 'lock' ? (search?.value.trim().toLowerCase() ?? '') : '';

		categoryTabs.forEach((tab) => {
			tab.setAttribute('aria-selected', String(tab.dataset.kindFilter === activeKind));
		});

		brandTabs.forEach((tab) => {
			const brand = tab.dataset.brandFilter;
			const brandKinds = tab.dataset.brandKinds?.split(' ') ?? [];
			const visible = brand === 'all' || brandKinds.includes(activeKind);
			tab.hidden = !visible;
			tab.setAttribute('aria-selected', String(visible && brand === activeBrand));
		});

		brandLinks.forEach((link) => {
			link.hidden = !(link.dataset.brandKinds?.split(' ') ?? []).includes(activeKind);
		});

		if (lockFilters) lockFilters.hidden = activeKind !== 'lock';

		let shown = 0;
		cards.forEach((card) => {
			const matchKind = card.dataset.kind === activeKind;
			const matchBrand = activeBrand === 'all' || card.dataset.brand === activeBrand;
			const matchSearch = !query || (card.dataset.searchName ?? '').includes(query);
			const values = new Set((card.dataset.filterValues ?? '').split(' ').filter(Boolean));
			const matchFilters =
				activeKind !== 'lock' ||
				Array.from(activeFilters.values()).every((selected) =>
					selected.some((value) => values.has(value)),
				);
			const match = matchKind && matchBrand && matchSearch && matchFilters;
			card.hidden = !match;
			if (match) shown += 1;
		});

		if (empty) empty.hidden = shown > 0;
	};

	categoryTabs.forEach((tab) =>
		tab.addEventListener('click', () => {
			activeKind = tab.dataset.kindFilter ?? 'lock';
			activeBrand = 'all';
			render();
		}),
	);

	brandTabs.forEach((tab) =>
		tab.addEventListener('click', () => {
			activeBrand = tab.dataset.brandFilter ?? 'all';
			render();
		}),
	);

	lockFilterInputs.forEach((input) => input.addEventListener('change', render));
	search?.addEventListener('input', render);

	reset?.addEventListener('click', () => {
		lockFilterInputs.forEach((input) => {
			input.checked = false;
		});
		if (search) search.value = '';
		render();
	});

	render();
</script>

<style>
	.category-tab[aria-selected='true'] {
		background: var(--color-accent-color);
		border-color: var(--color-accent-color);
		color: var(--color-main-color);
	}

	.category-tab[aria-selected='true'] span {
		color: var(--color-main-color);
	}

	.category-tab:hover[aria-selected='false'] {
		border-color: color-mix(in srgb, var(--color-accent-color) 45%, transparent);
		background: color-mix(in srgb, var(--color-accent-color) 8%, var(--color-secondary-color));
	}

	.filter-tab[aria-selected='true'] {
		background: var(--color-accent-color);
		border-color: var(--color-accent-color);
		color: var(--color-main-color);
		font-weight: 600;
	}

	.filter-tab:hover[aria-selected='false'] {
		border-color: color-mix(in srgb, var(--color-accent-color) 45%, transparent);
		color: #fff;
	}

	.filter-check:has(input:checked) {
		background: color-mix(in srgb, var(--color-accent-color) 12%, transparent);
		color: #fff;
	}

	.filter-group summary::-webkit-details-marker {
		display: none;
	}

	.filter-group[open] {
		border-color: color-mix(in srgb, var(--color-accent-color) 28%, var(--color-line));
	}

	.filter-group[open] .filter-chevron {
		transform: rotate(180deg);
		color: var(--color-accent-color);
	}
</style>
