---
import SectionHeading from './SectionHeading.astro';
import { type Lang, ui } from '../i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
---

<section class="bg-ink px-5 pb-10 pt-28 sm:px-8 sm:pb-14 sm:pt-32 lg:px-12 xl:min-h-[calc(100vh-5rem)] xl:pb-28">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			eyebrow={t.installDelivery.eyebrow}
			title={t.installDelivery.title}
			accent={t.installDelivery.titleAccent}
			class="reveal"
		/>

		<div class="service-grid reveal mt-10 grid gap-5 sm:mt-12 lg:grid-cols-2 xl:mt-14 xl:gap-7">
			{
				t.installDelivery.sections.map((section, index) => (
					<article class="service-card rounded-2xl border border-accent-color/25 bg-secondary-color p-6 shadow-[0_22px_90px_-55px_rgba(223,166,32,0.9)] transition hover:border-accent-color/45 sm:p-8 xl:min-h-[34rem] xl:p-10" style={`--step-index: ${index}`}>
						<h2 class="text-4xl font-semibold leading-none text-white sm:text-5xl xl:text-6xl">
							{section.title}
						</h2>
						<p class="mt-8 text-xl leading-9 text-white/58 sm:text-2xl sm:leading-[1.65]">
							{section.text}
						</p>
						<ul class="mt-10 grid gap-5 text-lg font-semibold leading-7 text-white/72 sm:text-xl">
							{section.items.map((item) => {
								/* Items may carry a short lead followed by an em dash explanation — the lead stays bright, the rest reads as body copy. */
								const [lead, ...rest] = item.split(' — ');
								const detail = rest.join(' — ');

								return (
									<li class="flex gap-5">
										<span class="mt-2.5 h-3 w-3 shrink-0 rounded-full bg-accent-color shadow-[0_0_20px_rgba(223,166,32,0.65)]" />
										<span>
											<span class="text-white">{lead}</span>
											{detail && <span class="font-normal text-white/58"> — {detail}</span>}
										</span>
									</li>
								);
							})}
						</ul>
						{section.outro.length > 0 && (
							<div class="mt-10 grid gap-5 text-lg leading-8 text-white/58 sm:text-xl sm:leading-9">
								{section.outro.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.service-card {
		animation: step-in 0.7s ease both;
		animation-delay: calc(var(--step-index) * 140ms);
	}

	@media (min-width: 1024px) {
		.service-card:nth-child(even) {
			transform: translateY(2.5rem);
		}
	}

	@keyframes step-in {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (min-width: 1024px) {
		.service-card:nth-child(even) {
			animation-name: step-in-offset;
		}
	}

	@keyframes step-in-offset {
		from {
			opacity: 0;
			transform: translateY(4rem);
		}
		to {
			opacity: 1;
			transform: translateY(2.5rem);
		}
	}
</style>
