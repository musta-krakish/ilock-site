---
import SectionHeading from './SectionHeading.astro';
import { site } from '../config';
import { type Lang, ui } from '../i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];
---

<section class="bg-ink px-5 pb-10 pt-28 sm:px-8 sm:pb-14 sm:pt-32 lg:px-12 xl:min-h-[calc(100vh-5rem)] xl:pb-28">
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			eyebrow={t.installDelivery.eyebrow}
			title={t.installDelivery.title}
			accent={t.installDelivery.titleAccent}
			class="reveal"
		/>

		<div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-start xl:mt-14 xl:gap-10">
			<div class="reveal rounded-2xl border border-accent-color/25 bg-secondary-color p-6 shadow-[0_22px_90px_-55px_rgba(223,166,32,0.9)] sm:p-8 xl:p-9">
				<p class="text-2xl font-semibold leading-tight text-white sm:text-3xl">
					{t.installDelivery.intro.split('—')[0]}
					<span class="text-accent-color">—{t.installDelivery.intro.split('—')[1]}</span>
				</p>
				<p class="mt-6 text-base leading-8 text-white/60 sm:text-lg">
					{t.installDelivery.afterPurchase}
				</p>

				<div class="mt-8 grid gap-3">
					{
					site.branches.map((branch) => (
							<div class="rounded-xl border border-line/80 bg-main-color/35 px-4 py-3 xl:px-5 xl:py-4">
								<p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-color">
									{branch.city}
								</p>
								<p class="mt-1 text-white/72">
									{branch.address}
									{'floor' in branch && <span class="text-white/45"> · {branch.floor}</span>}
								</p>
							</div>
						))
					}
				</div>
			</div>

			<div class="steps-grid reveal">
				{
					t.installDelivery.sections.map((step, index) => (
						<article class="service-step rounded-2xl border border-line bg-secondary-color/78 p-6 transition hover:border-accent-color/45 sm:p-7 xl:min-h-56 xl:p-8" style={`--step-index: ${index}`}>
							<span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-color text-sm font-bold text-main-color">
								{index + 1}
							</span>
							<h2 class="mt-5 text-2xl font-semibold text-white">{step.title}</h2>
							<p class="mt-3 text-base leading-7 text-white/58">{step.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.steps-grid {
		display: grid;
		gap: 1rem;
	}

	.service-step {
		animation: step-in 0.7s ease both;
		animation-delay: calc(var(--step-index) * 140ms);
	}

	@media (min-width: 1024px) {
		.steps-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.service-step:nth-child(even) {
			transform: translateY(2.5rem);
		}
	}

	@keyframes step-in {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (min-width: 1024px) {
		.service-step:nth-child(even) {
			animation-name: step-in-offset;
		}
	}

	@keyframes step-in-offset {
		from {
			opacity: 0;
			transform: translateY(4rem);
		}
		to {
			opacity: 1;
			transform: translateY(2.5rem);
		}
	}
</style>
