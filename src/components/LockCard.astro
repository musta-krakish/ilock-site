---
import { Image } from 'astro:assets';
import { formatPrice } from '../config';
import { brandNames, getLocalePath, type Lang, type LocalizedLock, ui } from '../i18n';
import { lockFilterValues } from '../lib/lock-filters';
import { hasGiftInstallation, promotionCopy } from '../lib/promotions';

interface Props {
	lock: LocalizedLock;
	lang?: Lang;
	eager?: boolean;
}

const { lock, lang = 'ru', eager = false } = Astro.props;
const t = ui[lang];
const homePath = getLocalePath(lang);
const promo = promotionCopy[lang];
const hasInstallationGift = hasGiftInstallation(lock);

const highlight = (['face', 'palm', 'fingerprint', 'pin', 'card', 'app', 'key'] as const)
	.filter((a) => lock.access.includes(a))
	.slice(0, 3);

const cardFilterValues = lockFilterValues(lock);
---

<a
	href={`${homePath}catalog/${lock.slug}/`}
	data-brand={lock.brand}
	data-kind={lock.kind}
	data-filter-values={cardFilterValues.join(' ')}
	data-price={lock.price}
	data-title={lock.title.toLowerCase()}
	data-search-name={`${brandNames[lock.brand]} ${lock.title}`.toLowerCase()}
	class="lock-card group flex min-w-[82vw] snap-start flex-col overflow-hidden rounded-[1.65rem] border border-line bg-secondary-color shadow-[0_28px_70px_-46px_rgba(0,0,0,0.95)] panel-hover sm:min-w-0 sm:rounded-2xl"
>
	<div class="relative aspect-[0.92] overflow-hidden bg-linear-to-b from-[#d2d2d2] to-[#bdbdbd] sm:aspect-square">
		<Image
			src={lock.image}
			alt={t.product.imgAlt(brandNames[lock.brand], lock.title, lock.kind)}
			width={640}
			class="h-full w-full object-contain p-7 transition-transform duration-500 group-hover:scale-[1.06] sm:p-8"
			loading={eager ? 'eager' : 'lazy'}
		/>

		<div class="absolute left-3 top-3 flex flex-col items-start gap-2">
			{
				hasInstallationGift && (
					<span class="inline-flex items-center gap-1.5 rounded-full border border-amber-100/60 bg-linear-to-r from-fuchsia-600 via-violet-600 to-amber-500 px-3 py-1 text-[11px] font-bold tracking-wide text-white shadow-[0_0_24px_rgba(217,70,239,0.75)]">
						<span aria-hidden="true">✦</span>
						{promo.giftInstallation}
					</span>
				)
			}
			{
				lock.featured && !lock.comingSoon && (
					<span class="rounded-full bg-accent-color px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-main-color">
						{t.catalog.featured}
					</span>
				)
			}
			{
				lock.kazakhBrand && (
					<span class="rounded-full border border-white/20 bg-main-color/80 px-3 py-1 text-[11px] font-medium text-white/75">
						{t.catalog.kazakhBrand}
					</span>
				)
			}
		</div>
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<div class="flex items-center justify-between gap-3">
			<span class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-color">
				{brandNames[lock.brand]}
			</span>
			<span class="text-xs text-white/40">
				{lock.kind === 'accessory' ? t.catalog.accessory : t.specs.material[lock.material]}
			</span>
		</div>

		<h3 class="mt-3 text-2xl font-bold leading-tight text-white sm:text-2xl">{lock.title}</h3>

		<p class="mt-3 line-clamp-2 text-sm leading-6 text-white/55 sm:line-clamp-3">{lock.description}</p>

		{
			highlight.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-1.5">
					{highlight.map((a) => (
						<li class="rounded-full border border-line bg-surface px-2.5 py-1 text-[11px] text-white/60">
							{t.specs.access[a]}
						</li>
					))}
				</ul>
			)
		}

		<div class="mt-auto flex items-end justify-between gap-3 border-t border-line pt-5">
			<div>
				{lock.oldPrice && <p class="mb-0.5 text-sm font-medium text-white/40 line-through">{formatPrice(lock.oldPrice)}</p>}
				<p class="text-2xl font-semibold tracking-tight text-accent-color">
					{lock.priceTo && <span class="mr-1 text-sm font-sans font-normal text-white/40">{t.catalog.from}</span>}
					{formatPrice(lock.price, lock.priceTo)}
				</p>
			</div>
			<span class="text-xs font-medium text-white/45 transition group-hover:text-accent-color">
				{t.catalog.details} →
			</span>
		</div>
	</div>
</a>
