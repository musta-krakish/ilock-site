---
import { getCollection, render } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import { type Lang, ui } from '../i18n';

interface Props {
	lang?: Lang;
	standalone?: boolean;
}

const { lang = 'ru', standalone = false } = Astro.props;
const t = ui[lang];
const faqItems = await Promise.all(
	(await getCollection('faq'))
		.filter((item) => item.data.lang === lang)
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (item) => ({
			...item.data,
			Content: (await render(item)).Content,
		})),
);
---

<section
	id="faq"
	class:list={[
		'bg-ink px-5 py-10 sm:px-8 sm:py-14 lg:px-12 xl:pb-28',
		standalone && 'pt-28 sm:pt-32',
		standalone && 'xl:min-h-[calc(100vh-5rem)]',
	]}
>
	<div class="mx-auto max-w-7xl">
		<SectionHeading
			eyebrow={t.faq.eyebrow}
			title={t.faq.title}
			accent={t.faq.titleAccent}
			class="reveal"
		/>

		<div class="reveal mt-10 grid gap-3 sm:mt-12 lg:grid-cols-2 xl:mt-14 xl:gap-4">
			{
				faqItems.map((item) => (
					<details class="faq-item group rounded-2xl border border-line bg-secondary-color/72 transition open:border-accent-color/45">
						<summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-base font-semibold leading-snug text-white transition hover:text-accent-color sm:px-6 xl:min-h-20 xl:px-7">
							<span>{item.question}</span>
							<span class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-lg text-white/45 transition group-open:rotate-45 group-open:border-accent-color group-open:text-accent-color">
								+
							</span>
						</summary>
						<div class="faq-answer px-5 pb-5 text-sm leading-7 text-white/55 sm:px-6 sm:text-base xl:px-7 xl:pb-7">
							<item.Content />
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-answer :global(p) {
		margin: 0;
	}

	.faq-answer :global(p + p),
	.faq-answer :global(p + ul) {
		margin-top: 1rem;
	}

	.faq-answer :global(ul) {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.faq-answer :global(li + li) {
		margin-top: 0.375rem;
	}
</style>
