---
interface Props {
	eyebrow: string;
	title: string;
	accent?: string;
	text?: string;
	class?: string;
	headingLevel?: 'h1' | 'h2';
	pageSize?: boolean;
}

const { eyebrow, title, accent, text, class: className, headingLevel = 'h2', pageSize = false } = Astro.props;
const Heading = headingLevel;
---

<div class:list={['max-w-2xl', className]}>
	<p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-accent-color sm:text-sm">
		<span class="h-px w-8 shrink-0 bg-accent-color sm:w-12"></span>
		{eyebrow}
	</p>
	<Heading class:list={['mt-5 text-3xl font-semibold leading-tight tracking-tight sm:text-5xl', pageSize && 'sm:text-6xl']}>
		{title}{accent && <>{' '}<span class="gold-text">{accent}</span></>}
	</Heading>
	{text && <p class="mt-5 text-base leading-7 text-white/55 sm:text-lg">{text}</p>}
</div>
